__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
dist/
build/
*.egg-info/

# Wyniki lokalnych reprodukcji mogą być duże. Zasady śledzenia zostaną
# ustalone przed pierwszym uruchomieniem; na razie ignorujemy tylko pliki
# tymczasowe, nie katalogi wynikowe.
*.tmp
*.temp
*.log

# Archiwa wynikowe są pochodną plików JSON/MD zachowywanych w Git.
artifacts/*.zip

# Checkpointy i wyniki pilota ASD-001R są robocze. Do Git trafia wyłącznie
# zamrożony pełny wynik potwierdzający wskazany przez LATEST_RUN.txt.
reproduced/stage_06_asd_001r_pilot/
reproduced/stage_06_asd_001r_pilot_checkpoint/
reproduced/stage_06_asd_001r_full_checkpoint/
reproduced/stage_06_asd_checkpoint/

# Etap 07: pilot/smoke jest roboczy; w closeoucie śledzimy wskazany pełny bieg.
reproduced/stage_07_runs/*/
!reproduced/stage_07_runs/20260925T222755Z/
!reproduced/stage_07_runs/20260925T222755Z/**
reproduced/stage_07r_pilot/

# Pobrane zbiory Etapu 09 są lokalnym cache i nie trafiają do Git.
reproduced/stage_09_dataset_cache/

# Checkpoint 180 komórek Etapu 10 umożliwia bezpieczne wznawianie długiego biegu.
reproduced/stage_10_checkpoint/

# Etap 11: cache zbiorów i checkpointy dwóch wspólnych rekonstrukcji.
reproduced/stage_11_dataset_cache/
reproduced/stage_11_checkpoint/
